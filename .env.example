# ==============================================================================
# AGENT-READY MERCHANT: ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Security Notice: 
# 1. Never commit a live '.env' file containing real credentials to version control.
# 2. These credentials must NEVER be exposed to LLM context windows or client browsers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development              # Options: development, test, staging, production
DEBUG=true                           # Set to false in production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-jwt-and-session-signing

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16+)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_ready_merchant
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/agent_ready_merchant
DB_ECHO=false                        # Log SQL queries for debugging (development only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 3. RAZORPAY TEST-MODE CREDENTIALS
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Generate Test Key)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Webhook Secret configured in Razorpay Dashboard -> Webhooks -> Add New Webhook
# Subscribed Events: order.paid, payment.authorized, payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Base URL for Razorpay API (Defaults to live endpoint, test mode is determined by key)
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# ------------------------------------------------------------------------------
# 4. LLM PROVIDER CONFIGURATION (Google Gemini / Provider-Agnostic)
# ------------------------------------------------------------------------------
# 
GROQ_API_KEY=YourGroqApiKeyHere
LLM_MODEL_NAME=openai/gpt-oss-20b      
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2                  # Low temperature for deterministic structured reasoning
LLM_STEP_LIMIT=5                     # Max recursive tool steps per turn
LLM_TIMEOUT_SECONDS=15               # Hard wall-clock timeout per run

# ------------------------------------------------------------------------------
# 5. MERCHANT DEFAULT POLICIES & BOUNDARIES
# ------------------------------------------------------------------------------
DEFAULT_MERCHANT_AUTONOMY_LEVEL=1     # 0: Read-Only, 1: Bounded Auto (Default), 2: Supervised HITL
DEFAULT_MAX_DISCOUNT_PERCENTAGE=15.0  # Max allowable discount percentage
DEFAULT_MIN_MARGIN_PERCENTAGE=20.0    # Min profit margin above cost price
DEFAULT_QUOTE_TTL_MINUTES=15          # Expiry time for generated price quotes
MAX_SINGLE_TRANSACTION_PAISE=10000000 # ₹1,00,000 max single transaction cap (in paise)

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY GUARDS
# ------------------------------------------------------------------------------
SESSION_RATE_LIMIT_PER_MINUTE=20      # Max requests per session per minute
MAX_ACTIVE_QUOTES_PER_BUYER=3         # Anti-inventory-starvation threshold
LOG_LEVEL=INFO                        # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
